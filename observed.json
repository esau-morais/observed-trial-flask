{
  "schemaVersion": 1,
  "name": "Water temperature",
  "source": {
    "entry": "app.py",
    "paths": [
      "app.py",
      "requirements.txt",
      "templates/index.html",
      "static/stations.js",
      "static/style.css",
      "data/settings.json"
    ]
  },
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".venv"
    ],
    [
      ".venv/bin/pip",
      "install",
      "-r",
      "requirements.txt"
    ]
  ],
  "start": [
    ".venv/bin/python",
    "app.py"
  ],
  "ready": {
    "path": "/",
    "status": 200
  },
  "capture": {
    "name": "Show stations",
    "path": "/",
    "ready": [
      {
        "kind": "wait-text",
        "text": "Show stations"
      },
      {
        "kind": "network-idle"
      }
    ],
    "steps": [
      {
        "kind": "click-role",
        "role": "button",
        "name": "Show stations"
      },
      {
        "kind": "wait-selector",
        "selector": "tbody tr"
      },
      {
        "kind": "network-idle"
      }
    ],
    "check": {
      "kind": "text",
      "id": "three-stations",
      "name": "Three stations loaded",
      "scope": "Click Show stations through completion and network idle.",
      "selector": "#status",
      "expectedText": "3 stations"
    },
    "browserArguments": [
      "--no-sandbox"
    ]
  }
}
